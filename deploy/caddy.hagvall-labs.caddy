# Imported security_headers is defined by the shared Maskera edge Caddyfile.
www.hagvall-labs.com {
	import security_headers
	redir https://hagvall-labs.com{uri} permanent
}

hagvall-labs.com {
	encode zstd gzip
	import security_headers
	request_body {
		max_size 1MB
	}

	# Operational access log. IPs are truncated before they ever hit disk
	# (IPv4 to /24, IPv6 to /48), and cookie/auth headers are never written.
	# Visitor analytics is handled separately by the self-hosted Umami service.
	# The Caddy container needs /var/log/caddy bind-mounted to the host for the
	# log to survive and be readable outside the container.
	log {
		output file /var/log/caddy/hagvall-labs.access.log {
			# The host directory is root:deploy with its setgid bit set, so
			# rotated logs inherit the deploy group and analytics.sh can read
			# them without running as root.
			mode 0640
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>headers>Cookie delete
			request>headers>Authorization delete
		}
	}

	# Keep the tracker and collection request same-origin. Only Umami's public
	# collection endpoints are exposed under the marketing-site hostname.
	@umami_public path /analytics/script.js /analytics/api/send /analytics/api/websites/*/recorder
	handle @umami_public {
		uri strip_prefix /analytics
		reverse_proxy umami:3000 {
			header_up Host analytics.hagvall-labs.com
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	handle {
		reverse_proxy hagvall-labs:4173 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}
}

# The Wix DNS record for analytics.hagvall-labs.com can be added without
# another deploy. The sslip.io hostname makes the private dashboard reachable
# until that record exists; collection itself never depends on either hostname.
analytics.hagvall-labs.com, analytics.188.245.110.104.sslip.io {
	encode zstd gzip
	import security_headers
	header X-Robots-Tag "noindex, nofollow, noarchive"
	request_body {
		max_size 1MB
	}

	@robots path /robots.txt
	respond @robots "User-agent: *\nDisallow: /\n" 200

	reverse_proxy umami:3000 {
		header_up X-Forwarded-For {http.request.remote.host}
	}
}
