# Official Node image on the same Alpine release as the Umami image below.
# The digest pins the patched Node 22 binary.
FROM node:22.23.4-alpine3.24@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS node

# Umami's own image ships an outdated Node: 3.2.0 has 22.23.1 and even 3.4.0
# only has 22.23.2, which misses the October 2026 Node security releases. Keep
# the pinned Umami release and swap in the patched binary; Node 22 keeps the
# same module ABI, so Umami's native dependencies load unchanged.
FROM ghcr.io/umami-software/umami:3.2.0@sha256:8edfe4beaef13f9d1300619fa264ef250a3688df9cc54d24ca830ca31cb475ec

COPY --from=node /usr/local/bin/node /usr/local/bin/node

ENV NODE_VERSION=22.23.4

# The Alpine packages in the Umami image (curl, c-ares, OpenSSL) also lag
# behind their security fixes. The published image is pinned by digest, so
# this upgrade is fixed at build time.
USER root
RUN apk upgrade --no-cache
USER nextjs

RUN ["node", "-e", "if (process.version !== 'v' + process.env.NODE_VERSION) { console.error('unexpected Node ' + process.version); process.exit(1) }"]
